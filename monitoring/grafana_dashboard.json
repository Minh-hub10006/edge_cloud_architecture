{
  "uid": "edge-video-platform-state",
  "title": "Edge Video Platform — DRL State Monitor",
  "tags": ["edge-video-platform", "drl", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "description": "Prometheus datasource used for Edge state metrics", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "refresh": "2s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {
    "list": [
      {"name": "node", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(edge_state_window_id, node)", "refresh": 2, "includeAll": true, "allValue": ".*", "current": {"selected": true, "text": "All", "value": "$__all"}}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Latest source window", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "edge_state_window_id{node=~\"$node\"}", "legendFormat": "{{node}} / {{camera}} / {{stream}}"}], "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}},
    {"id": 2, "type": "timeseries", "title": "Effective FPS", "gridPos": {"h": 7, "w": 12, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "edge_state_effective_fps{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"effective_fps\",node=~\"$node\"} == 1)", "legendFormat": "{{node}} {{model}} {{transport}}"}], "fieldConfig": {"defaults": {"unit": "fps", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 3, "type": "timeseries", "title": "Media match rate", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "edge_state_media_match_rate{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"media_match_rate\",node=~\"$node\"} == 1)", "legendFormat": "{{node}} {{model}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 4, "type": "timeseries", "title": "RTT / inference latency (ms)", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 7}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "edge_state_transport_rtt_ms{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"transport_rtt_ms\",node=~\"$node\"} == 1)", "legendFormat": "transport {{node}} {{model}}"}, {"expr": "edge_state_edge_inference_ms{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"edge_inference_ms\",node=~\"$node\"} == 1)", "legendFormat": "edge infer {{node}} {{model}}"}, {"expr": "edge_state_cloud_e2e_ms{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"cloud_e2e_ms\",node=~\"$node\"} == 1)", "legendFormat": "cloud path {{node}} {{model}}"}], "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 5, "type": "timeseries", "title": "Queue / inflight normalized", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 14}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "edge_state_edge_backlog_norm{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"edge_backlog_norm\",node=~\"$node\"} == 1)", "legendFormat": "edge backlog {{node}}"}, {"expr": "edge_state_cloud_inflight_norm{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"cloud_inflight_norm\",node=~\"$node\"} == 1)", "legendFormat": "cloud inflight {{node}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 6, "type": "timeseries", "title": "Scene / confidence features", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 14}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "edge_state_blur_difficulty_mean{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"blur_difficulty_mean\",node=~\"$node\"} == 1)", "legendFormat": "blur difficulty {{node}}"}, {"expr": "edge_state_calibrated_confidence_mean{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"calibrated_confidence_mean\",node=~\"$node\"} == 1)", "legendFormat": "calibrated confidence {{node}}"}, {"expr": "edge_state_box_change_mean{node=~\"$node\"} and on(node,camera,stream,epoch,model,transport) (edge_state_feature_available{feature=\"box_change_mean\",node=~\"$node\"} == 1)", "legendFormat": "box change {{node}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 7, "type": "timeseries", "title": "Per-feature available samples", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 21}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "edge_state_feature_available{node=~\"$node\"}", "legendFormat": "{{node}} {{model}} {{feature}}"}, {"expr": "edge_state_feature_samples{node=~\"$node\"}", "legendFormat": "samples {{node}} {{feature}}"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi", "sort": "desc"}}}
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": []
}
